# Copy to .env.local (local dev) or add in Vercel → Project → Settings → Environment Variables.
# Both values are required. Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional – NOT used by the Next.js app. Set these as Supabase Edge Function
# secrets for the new-check-in email alert (see README → Email alerts):
#   supabase secrets set RESEND_API_KEY=re_... WEBHOOK_SECRET=... ALERT_FROM_EMAIL="Check-in <alerts@yourdomain.com.au>" DASHBOARD_URL=https://your-app.vercel.app/dashboard
RESEND_API_KEY=

# --- Tests: put these in .env.test.local (git-ignored). STAGING project only ---
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=
TEST_OWNER_EMAIL=
TEST_OWNER_PASSWORD=
# Production project ref(s), comma-separated. Tests refuse to run against these.
# Locally it is also read from NEXT_PUBLIC_SUPABASE_URL in .env.local.
PROD_SUPABASE_PROJECT_REFS=
